# Postgres (local: docker compose up -d, then use URL below)
DATABASE_URL="postgresql://gymsanity:gymsanity@localhost:5432/gymsanity"

JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Public site URL — required for Stripe redirects & metadata. No trailing slash.
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Vercel + custom domain gymsanity.fit):
# NEXT_PUBLIC_APP_URL="https://gymsanity.fit"

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Publishable key (pk_...) — required for in-app Embedded Checkout on /subscribe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret — https://dashboard.stripe.com/webhooks (or `stripe listen` for local)
STRIPE_WEBHOOK_SECRET=""

# Recurring subscription Price IDs (Stripe Dashboard → Products → recurring price per plan). Seed maps these to Plan rows.
STRIPE_PRICE_DIGITAL=""
STRIPE_PRICE_ELITE=""
