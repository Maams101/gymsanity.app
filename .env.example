# Postgres (local: docker compose up -d, then use URL below)
DATABASE_URL="postgresql://gymsanity:gymsanity@localhost:5432/gymsanity"

JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Public site URL — required for Stripe redirects & metadata. No trailing slash.
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Vercel + custom domain gymsanity.fit):
# NEXT_PUBLIC_APP_URL="https://gymsanity.fit"

# Stripe — single merchant account (Gymsanity LLC for production). See docs/STRIPE_LLC_SETUP.md
# Never commit real keys. Production: set live keys in Vercel only (sk_live_ / pk_live_).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Publishable key (pk_...) — required for in-app Embedded Checkout on /subscribe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret — https://dashboard.stripe.com/webhooks (or `stripe listen` for local)
# Production endpoint: https://gymsanity.fit/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Price IDs (Dashboard → Product catalog). Seed writes these to Plan.stripePriceId.
# digital = recurring; sessions-* = one-time. Do not mix test prices with live keys.
STRIPE_PRICE_DIGITAL=""
STRIPE_PRICE_SESSIONS_1=""
STRIPE_PRICE_SESSIONS_6=""
STRIPE_PRICE_SESSIONS_12=""
STRIPE_PRICE_SESSIONS_24=""
# Legacy — not used by current seed / offered plans
# STRIPE_PRICE_ELITE=""

# Apple Pay: gymsanity.fit + www are registered as Stripe payment method domains (Live).
# Association file also at public/.well-known/apple-developer-merchantid-domain-association
# Optional override for PMC (defaults to Gymsanity LLC Default which has Apple Pay on):
# STRIPE_PAYMENT_METHOD_CONFIGURATION="pmc_..."

# Optional: program title to deep-link after focus-group signup (default: Focus Group Challenge)
# FOCUS_GROUP_PROGRAM_TITLE="Focus Group Challenge"
RESEND_API_KEY=""
# Verified sender, e.g. Gymsanity <hello@gymsanity.fit>
NEWSLETTER_FROM=""
